{
  // Shared compiler settings. Every workspace package extends this and adds
  // only what differs (lib, jsx, paths). Type-checking is `tsc --noEmit` per
  // package — bun and Next.js do the actual transpilation.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,

    "strict": true,
    // Beyond `strict`:
    //   exactOptionalPropertyTypes — `{ title?: string }` stops accepting an
    //     explicit `undefined`; spread conditionally instead of assigning it.
    //   verbatimModuleSyntax — type-only imports must say `import type`, so
    //     nothing is pulled into a bundle merely to satisfy a type.
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  }
}
