# deps / build
node_modules/
.next/
dist/
out/
*.tsbuildinfo
next-env.d.ts

# env — never commit secrets; commit .env.example instead
.env
.env.*
!.env.example

# local AI / orchestration machinery — private, never published. These write
# their reports into .ai/, which is itself private, so publishing them would
# leave a contributor with scripts that reference a directory they don't have.
.claude/
.ai/
scripts/validate-build.ts
scripts/validate-runtime.ts

# local/ is the home for anything a maintainer or contributor keeps beside
# the code but never publishes — working notes, drafts, scratch files.
# Public versions of durable docs live in docs/ instead.
local/

# vercel
.vercel/

# OS
.DS_Store

# orchestrator working artifacts — local only (durable ones get promoted to
# ../internal). Root-anchored: an unanchored tasks/ would swallow real source
# directories like worker/src/tasks/. PRDs, ADDs and decision records now live
# under .ai/, ignored above; the docs/ entries are their retired homes, kept so
# a stale writer cannot publish one.
/tasks/
/docs/prds/
/docs/adds/
/docs/decisions/
